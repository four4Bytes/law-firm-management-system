# ════════════════════════════════════════════════════════════
# DOCKER COMPOSE (production)
# ════════════════════════════════════════════════════════════
# Unlike dev, this file is ALSO consumed by the application
# containers (`web`, `migrate`) via env_file — so it must contain
# both infrastructure AND application runtime variables.

COMPOSE_FILE=docker-compose.prod.yml
COMPOSE_PROJECT_NAME=law-firm-management-system-production

# ════════════════════════════════════════════════════════════
# POSTGRESQL
# ════════════════════════════════════════════════════════════
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# ════════════════════════════════════════════════════════════
# MINIO (S3-compatible storage)
# ════════════════════════════════════════════════════════════
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# MinIO SSE-S3 encryption at rest (32-byte base64 key)
# Generate:  openssl rand -base64 32
# Add the real value to .env.prod (gitignored) — never commit the key.
# MINIO_KMS_SECRET_KEY=
# MINIO_KMS_AUTO_ENCRYPTION=on

# ════════════════════════════════════════════════════════════
# APPLICATION RUNTIME (consumed by Next.js / Prisma containers)
# ════════════════════════════════════════════════════════════

# ── Database ──
DATABASE_URL=postgresql://user:password@db:5432/dbname

# ── Authentication ──
# AUTH_SECRET:  openssl rand -hex 32
# Google OAuth: https://console.cloud.google.com/apis/credentials
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Developer Access ──
# Comma-separated Google accounts allowed to sign in without being
# pre-registered (auto-created as bootstrap Dev-role users).
DEVELOPER_EMAILS=

# ── S3 Storage (MinIO in Docker network) ──
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=law-firm-files
S3_FORCE_PATH_STYLE=true

# ── Email (Gmail SMTP) ──
# Generate an App Password:  https://myaccount.google.com/apppasswords
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-16-char-app-password
# EMAIL_FROM="Anino Law Firm <your-email@gmail.com>"
# EMAIL_SECURE=false

# ── Application URL ──
# Used to build absolute links in email notifications (e.g. https://app.example.com)
APP_ORIGIN=
DEFAULT_REMINDER_DAYS=3
# APP_TIMEZONE=Asia/Manila
# IANA timezone used for server-side date/time display. Defaults to the server's local timezone.
NOTIFICATION_RETENTION_DAYS=90

# ── Cron / Scheduled Jobs ──
# Used by Vercel Cron Jobs (or external cron service) to authenticate requests.
# Generate a random string: openssl rand -hex 32
CRON_SECRET=

# Storage GC sweep schedule for self-hosted deployments (node-cron format).
# Runs weekly on Sunday at 03:00 by default. Override in .env.prod if needed.
# STORAGE_GC_CRON_SCHEDULE=0 3 * * 0
