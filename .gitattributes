# Normalize all text files to LF in the repo and on checkout,
# so Windows and Linux working copies are identical.
* text=auto eol=lf

# Windows scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# sops-encrypted secrets: decrypt for readable diffs.
# One-time setup: git config diff.sops.textconv "sops decrypt"
secrets/*.enc.env diff=sops
secrets/*.enc.yaml diff=sops

# Binaries - never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
