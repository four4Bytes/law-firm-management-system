# ════════════════════════════════════════════════════════════
# DOCKER COMPOSE (dev) — infrastructure only
# ════════════════════════════════════════════════════════════
# Consumed exclusively by `make dev-*` targets (docker compose
# --env-file .env.dev). The Next.js app itself does NOT read this
# file — application runtime variables live in `.env`.

COMPOSE_FILE=docker-compose.yml
COMPOSE_PROJECT_NAME=law-firm-management-system-development

# ════════════════════════════════════════════════════════════
# POSTGRESQL
# ════════════════════════════════════════════════════════════
POSTGRES_DB=testing
POSTGRES_USER=testing
POSTGRES_PASSWORD=testing

# ════════════════════════════════════════════════════════════
# MINIO (S3-compatible storage)
# ════════════════════════════════════════════════════════════
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MinIO SSE-S3 encryption at rest (32-byte base64 key)
# Generate:  openssl rand -base64 32
# Add the real value to .env.dev (gitignored) — never commit the key.
# MINIO_KMS_SECRET_KEY=
# MINIO_KMS_AUTO_ENCRYPTION=on
