# ════════════════════════════════════════════════════════════
# DOCKER COMPOSE (dev) - infrastructure only
# ════════════════════════════════════════════════════════════
# Consumed exclusively by `make dev-*` targets (docker compose
# --env-file .env.dev). The Next.js app itself does NOT read this
# file - application runtime variables live in `.env`.

COMPOSE_FILE=docker-compose.yml
COMPOSE_PROJECT_NAME=law-firm-management-system-development

# ════════════════════════════════════════════════════════════
# POSTGRESQL
# ════════════════════════════════════════════════════════════
POSTGRES_DB=testing
POSTGRES_USER=testing
POSTGRES_PASSWORD=testing

# ════════════════════════════════════════════════════════════
# SEAWEEDFS (S3-compatible storage)
# ════════════════════════════════════════════════════════════
# SeaweedFS SSE-S3 KEK: exactly 64 hexadecimal characters.
# Generate: openssl rand -hex 32
SEAWEEDFS_SSE_KEK=
S3_CORS_ALLOWED_ORIGINS=http://localhost:3000
