# ════════════════════════════════════════════════════════════
# DATABASE
# ════════════════════════════════════════════════════════════
# Local Postgres via Docker:  docker compose up -d
DATABASE_URL=postgresql://testing:testing@localhost:5432/testing

# ════════════════════════════════════════════════════════════
# AUTHENTICATION (NextAuth + Google OAuth)
# ════════════════════════════════════════════════════════════
# AUTH_SECRET:  openssl rand -hex 32
# Google OAuth: https://console.cloud.google.com/apis/credentials
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ════════════════════════════════════════════════════════════
# DEVELOPER ACCESS
# ════════════════════════════════════════════════════════════
# Comma-separated Google accounts allowed to sign in without being
# pre-registered (auto-created as bootstrap Dev-role users).
DEVELOPER_EMAILS=

# ════════════════════════════════════════════════════════════
# OBJECT STORAGE (S3-compatible — MinIO via Docker)
# ════════════════════════════════════════════════════════════
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=law-firm-files
S3_FORCE_PATH_STYLE=true

# ════════════════════════════════════════════════════════════
# EMAIL (SMTP — Mailpit for local dev)
# ════════════════════════════════════════════════════════════
# Web UI:  http://localhost:8025
EMAIL_FROM="Anino Law Firm <test@localhost>"
EMAIL_HOST=localhost
EMAIL_USER=mailpit
EMAIL_PASS=mailpit
EMAIL_PORT=1025
EMAIL_SECURE=false

# ════════════════════════════════════════════════════════════
# APPLICATION
# ════════════════════════════════════════════════════════════
APP_ORIGIN=http://localhost:3000
DEFAULT_REMINDER_DAYS=3
# APP_TIMEZONE=Asia/Manila
# IANA timezone used for server-side date/time display. Defaults to the server's local timezone.
NOTIFICATION_RETENTION_DAYS=90

# ── Cron / Scheduled Jobs ──
# Used by Vercel Cron Jobs (or external cron service) to authenticate requests.
# Generate a random string: openssl rand -hex 32
CRON_SECRET=

# Storage GC sweep schedule for self-hosted deployments (node-cron format).
# Runs weekly on Sunday at 03:00 by default. Override in .env if needed.
# STORAGE_GC_CRON_SCHEDULE=0 3 * * 0

NEXT_PUBLIC_APP_VERSION=0.0.0-dev

