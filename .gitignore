# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# cache
.eslintcache

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (plaintext — materialized via `make secrets-decrypt`, never committed)
.env
.env.dev
.env.prod
.env.staging

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

*storybook.log
storybook-static

.vscode

docs

.direnv/

# sops-encrypted secrets (*.enc.*) are committed; everything else under
# secrets/ is local-only plaintext (age keys, materialized files).
secrets/*
!secrets/*.enc.env
!secrets/*.enc.yaml
!secrets/.gitkeep
keys.txt
